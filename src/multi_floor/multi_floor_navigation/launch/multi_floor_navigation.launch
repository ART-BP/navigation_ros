<launch>
  <arg name="topology_file" default="$(find multi_floor_navigation)/config/multimap.yaml"/>
  <arg name="initial_floor" default="B4"/>
  <arg name="map_frame" default="map"/>

  <node pkg="multi_floor_navigation"
        type="multi_floor_navigation_node"
        name="multi_floor_navigation"
        output="screen">
    <param name="topology_file" value="$(arg topology_file)"/>
    <param name="initial_floor" value="$(arg initial_floor)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="plan_service" value="get_topology_plan"/>
    <param name="navigate_action" value="navigate"/>
    <param name="move_base_action" value="/move_base"/>
    <param name="stair_action" value="/stair_navigation"/>
    <param name="change_map_service" value="/change_map"/>
    <param name="clear_costmaps_service" value="/move_base/clear_costmaps"/>
    <param name="server_timeout" value="5.0"/>
    <param name="stair_server_timeout" value="5.0"/>
    <param name="segment_timeout" value="0.0"/>
  </node>

  <node pkg="multi_floor_navigation"
        type="stair_executor_node"
        name="stair_executor"
        output="screen">
    <param name="action_name" value="/stair_navigation"/>
    <param name="cmd_vel_topic" value="/cmd_vel"/>
    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_link"/>
    <param name="control_rate" value="20.0"/>
    <param name="tf_timeout" value="0.2"/>

    <param name="start_position_tolerance" value="0.30"/>
    <param name="start_yaw_tolerance" value="0.2"/>
    <param name="waypoint_position_tolerance" value="0.12"/>
    <param name="lookahead_distance" value="0.35"/>
    <param name="centerline_slowdown_distance" value="0.12"/>
    <param name="max_centerline_deviation" value="0.25"/>

    <param name="min_linear_velocity" value="0.04"/>
    <param name="max_linear_velocity" value="0.45"/>
    <param name="max_angular_velocity" value="0.8"/>
    <param name="heading_stop_threshold" value="0.75"/>
    <param name="segment_timeout" value="60.0"/>

    <param name="linear_kp" value="0.8"/>
    <param name="linear_ki" value="0.0"/>
    <param name="linear_kd" value="0.05"/>
    <param name="linear_integral_limit" value="0.5"/>
    <param name="angular_kp" value="1.0"/>
    <param name="angular_ki" value="0.0"/>
    <param name="angular_kd" value="0.08"/>
    <param name="angular_integral_limit" value="0.5"/>
  </node>
</launch>
